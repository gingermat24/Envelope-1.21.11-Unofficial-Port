{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_page}",
    "sources": "${mod_github}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.mortuusars.envelope.fabric.EnvelopeFabric"
    ],
    "client": [
      "io.github.mortuusars.envelope.fabric.EnvelopeFabricClient"
    ],
    "jei_mod_plugin": [
      "io.github.mortuusars.envelope.integration.jei.EnvelopeJeiPlugin"
    ]
  },
  "mixins": [
    "${mod_id}-fabric.mixins.json",
    "${mod_id}-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ["1.21.11"],
    "fabric-api": "*",
    "forgeconfigapiport": ">=21.0.0"
  },
  "suggests": {
    "jei": ">=${jei_min_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "${mod_page}",
        "modmenu.issues": "${mod_issues}"
      }
    }
  }
}